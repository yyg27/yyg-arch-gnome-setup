# GNOME Shell extension settings, loaded by yyg-setup.sh with:
#   dconf load /org/gnome/shell/extensions/ < gnome-extensions.dconf
# GSConnect is excluded on purpose (contains paired device IDs).

[blur-my-shell]
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
pipeline='pipeline_default'
sigma=30

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=true
enable-mpris=false
indicator-position-max=3
user-enabled=false

[dash-to-dock]
background-opacity=0.80000000000000004
dash-max-icon-size=48
dock-position='BOTTOM'
height-fraction=0.90000000000000002
hot-keys=false
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'

[ding]
check-x11wayland=true
show-home=false
show-trash=false
start-corner='bottom-right'

[just-perfection]
accent-color-icon=false
accessibility-menu=true
activities-button=true
alt-tab-icon-size=0
dash-icon-size=40
notification-banner-position=1
osd-position=5
panel=true
panel-button-padding-size=0
panel-icon-size=16
panel-in-overview=true
panel-indicator-padding-size=0
panel-size=26
ripple-box=true
search=true
show-apps-button=true
startup-status=1
support-notifier-type=0
theme=false
window-demands-attention-focus=false
window-picker-icon=true
workspace=true
workspace-switcher-size=0
workspaces-in-app-grid=true

[lockkeys]
capslock-indicator='when-active'
numlock-indicator='never'
numlock-notification='osd'

[user-theme]
name='rewaita'

[vitals]
hot-sensors=['_memory_usage_', '_system_load_1m_', '__network-rx_max__']
position-in-panel=0
